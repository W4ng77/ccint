# ---- Bluesky (M2 collector) ----
# 在 https://bsky.app → Settings → Privacy and Security → App Passwords
# 生成一个 app password，名字随便起（建议 "ccint"）。
# [MUST] 用 app password，不要用账号主密码。
CCINT_BLUESKY_HANDLE=your-handle.bsky.social
CCINT_BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# PDS host。注意：本机出网策略拦截 *.bsky.app，必须走 bsky.social。
CCINT_BLUESKY_BASE_URL=https://bsky.social

# ---- Database (M1) ----
# 用户态 PostgreSQL 16 (pgserver)，unix socket，不占端口。
CCINT_PGDATA=/home/xinyu/jingrui/pgdata
CCINT_DB_NAME=ccint

# ---- Agent (M6，阶段 7 才用到) ----
ANTHROPIC_API_KEY=
CCINT_AGENT_MODEL=claude-opus-5
